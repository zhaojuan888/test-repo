[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = git@github.com:zhaojuan888/test-repo.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[credential]
	helper = !C:/Program Files/GitHub CLI/gh.exe auth git-credential
